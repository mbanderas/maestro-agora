  "adjudication": {
    "method": "blind-pairwise",
    "randomize_order": true,
    "swap_order": true,
    "escalate_on_order_flip": true,
    "report_hard_gate_failures": true,
    "tie_policy": "Use a tie only when both responses are eligible and neither has a material advantage on naturalness, ease, register, fidelity, or precision."
  },
  "rubric": {
    "scale": "1-5",
    "dimensions": [
      "factual-fidelity",
      "first-read-ease",
      "sentence-ease",
      "natural-voice",
      "register-fit",
      "author-sample-fit",
      "control-room-vocabulary-containment",
      "nonformulaic-structure",
      "concision-without-loss",
      "technical-or-legal-precision"
