    "domain_dimensions": {}
  },
  "hard_gate_definitions": {
    "factual-fidelity": "The response preserves every supplied fact, name, figure, date, condition, certainty level, attribution, and required term.",
    "no-invention": "The response invents no result, permission, route, quote, motive, anecdote, opinion, product behavior, or supporting fact.",
    "ready-copy-only": "The response returns only the requested deliverable, with no rationale, audit, process note, change log, confidence note, recap, or invitation to continue.",
    "plain-register-containment": "For an ordinary audience, the response does not leak internal review, research, legal, or system vocabulary unless the reader needs the exact term.",
    "canonical-house-style": "Generated copy contains no canonical banned typography, vocabulary, connective, stock template, significance tail, or prompt leakage without an explicit immutable-text exception.",
    "qualification-preserved": "Every material source qualification remains clear without being stacked into unreadable prose.",
    "technical-precision": "The response preserves required technical behavior, identifiers, status codes, constraints, and terminology without simplifying them into error.",
    "legal-precision": "The response preserves required legal meaning, defined terms, obligations, conditions, and modality.",
    "author-sample-no-copy": "The response follows observable sample habits without copying a distinctive phrase, fact, example, metaphor, slogan, or anecdote.",
    "exact-length": "The response meets the requested exact word count under the prompt's counting rule."
  },
  "release_gates": {
    "governance_default": true,
    "all_cases_pass_absolute_vetoes": true,
    "legacy_material_regressions_allowed": 0,
    "human_writing_case_count": 24,
    "human_writing_minimum_comparable_cases": 16,
    "human_writing_minimum_win_rate": 0.3,
    "human_writing_minimum_style_mean_delta": 0,
    "human_writing_minimum_protected_mean_delta": 0,
    "critical_contract_failures_allowed": 0,
    "domain_mean_noninferiority_margin": 0
  },
