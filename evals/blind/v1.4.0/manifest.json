{
  "schema_version": 3,
  "skill_version": "1.4.0",
  "generation_contract": {
    "pass_to_model": [
      "prompt_file"
    ],
    "never_pass_to_model": [
      "manifest.json",
      "case metadata",
      "rubric",
      "incumbent label",
      "expected output"
