{
  "schema_version": 1,
  "status": "frozen-release",
  "skill_version": "1.7.0",
  "generation_contract": {
    "pass_to_model": [
      "prompt_file"
    ],
    "never_pass_to_model": [
      "manifest.json",
      "case metadata",
      "rubric",
      "release gates",
      "incumbent label"
    ],
    "fresh_context_per_case": true,
    "isolated_skill_copy": true
  },
  "adjudication": {
    "method": "blind-pairwise",
    "randomize_order": true,
    "swap_order": true,
    "escalate_on_order_flip": true,
    "report_hard_gate_failures": true,
    "tie_policy": "Use a tie when both responses satisfy every declared boundary and neither has a material advantage for the supplied decision."
  },
  "rubric": {
    "scale": "1-5",
    "dimensions": [
      "brief-fidelity",
      "first-read-comprehension",
      "concrete-action-clarity",
      "outcome-fit",
      "funnel-stage-fit",
      "commitment-fit",
      "prior-calibration",
      "contradiction-handling",
      "composition-fit"
    ],
    "domain_dimensions": {}
  },
  "hard_gate_definitions": {
    "no-nearby-metric-substitution": "The response preserves the stated business outcome instead of replacing it with clicks, completions, or another nearby event.",
    "no-universal-prior": "The response does not turn a contextual conversion pattern into a law or fixed optimum.",
    "no-effect-transfer-in-review": "When review is requested, the response does not carry a reported effect size into a different business, audience, or surface.",
    "no-invented-proof-or-rationale": "The response uses only supplied proof, terms, permissions, data-use reasons, and operational facts.",
    "no-unauthorized-funnel-change": "The response preserves required fields, choices, steps, and commitments unless the user authorizes changes.",
    "commitment-and-terms-preserved": "The action label and surrounding copy state the supplied commitment, terms, reversibility, and next step clearly.",
    "route-reality-preserved": "The response distinguishes supplied self-serve and enterprise routes and does not invent a route that the business does not offer.",
    "pricing-decision-contract-preserved": "The response keeps supplied public prices, billing periods, limits, enterprise differences, and material buying terms visible at the decision.",
    "enterprise-risk-specificity": "The response connects supplied enterprise capabilities to concrete organizational requirements instead of relying on generic enterprise language.",
    "proof-uncertainty-match": "The response places supplied proof near the doubt it actually resolves and does not use unrelated proof to imply an unsupported capability.",
    "user-framing-preserved": "The response follows the user's selected emotional and commercial framing instead of replacing it with a preferred pattern.",
    "full-composition-fit": "The response optimizes the requested composition as a whole rather than treating one isolated element as the complete intervention."
  },
  "release_gates": {
    "governance_default": true,
    "all_cases_pass_absolute_vetoes": true,
    "legacy_material_regressions_allowed": 0,
    "conversion_wins_required": 10,
    "conversion_case_count": 13,
    "critical_contract_failures_allowed": 0,
    "domain_mean_noninferiority_margin": 0.25
  },
